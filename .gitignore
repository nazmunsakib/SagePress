# ============================================
# SagePress — Sage Based WordPress Starter Theme
# .gitignore
# ============================================

# -----------------------------------------------
# Dependencies (never commit these)
# -----------------------------------------------
/vendor/
/node_modules/

# -----------------------------------------------
# Built Assets (generated by `npm run build`)
# -----------------------------------------------
/public/build/
/public/hot

# -----------------------------------------------
# Acorn / Laravel Cache & Storage (auto-generated)
# -----------------------------------------------
/storage/framework/cache/
/storage/framework/views/
/storage/framework/testing/
/storage/logs/
/storage/*.key

# -----------------------------------------------
# Environment & Secrets
# -----------------------------------------------
.env
.env.*
!.env.example

# -----------------------------------------------
# OS & Editor Files
# -----------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# Windows
desktop.ini
$RECYCLE.BIN/

# VSCode
.vscode/
!.vscode/extensions.json

# JetBrains / PhpStorm
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# -----------------------------------------------
# Logs & Debug
# -----------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -----------------------------------------------
# Translation compiled files (generated)
# -----------------------------------------------
/resources/lang/*.mo
/resources/lang/*.json
!resources/lang/*.pot
!resources/lang/*.po

# -----------------------------------------------
# Misc
# -----------------------------------------------
*.zip
*.tar.gz
*.bak
*.swp
*.swo
{
  "name": "nazmunsakib/sagepress",
  "type": "wordpress-theme",
  "license": "MIT",
  "description": "WordPress starter theme with a modern development workflow",
  "homepage": "https://nazmunsakib.com/",
  "authors": [
    {
      "name": "Nazmun Sakib",
      "email": "nazmunsakib81@gmail.com",
      "homepage": "https://nazmunsakib.com/"
    }
  ],
  "keywords": [
    "wordpress"
  ],
  "support": {
    "issues": "https://github.com/nazmunsakib/sagepress/issues",
    "forum": "https://nazmunsakib.com/"
  },
  "autoload": {
    "psr-4": {
      "SagePress\\": "app/"
    }
  },
  "require": {
    "php": ">=8.3",
    "roots/acorn": "^6.0"
  },
  "require-dev": {
    "laravel/pint": "^1.20"
  },
  "suggest": {
    "log1x/sage-directives": "A collection of useful Blade directives for WordPress and Sage (^1.0)."
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "post-autoload-dump": [
      "Roots\\Acorn\\ComposerScripts::postAutoloadDump"
    ]
  }
}